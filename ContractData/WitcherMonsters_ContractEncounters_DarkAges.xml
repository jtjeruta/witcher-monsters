<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ContractFlavorDef MayRequire="Van.Beasts">
    <defName>WitcherMonsters_Flavor_DA_Leviathan</defName>
    <questTitle>Monster from the deep</questTitle>
    <questDescription>Fishers from [settlement] refuse the lake. A shelled titan with crushing claws dragged boats under — not a crab, they swear, a leviathan.</questDescription>
    <preferredScene>AbandonedCart</preferredScene>
  </ContractFlavorDef>
  <ContractFlavorDef MayRequire="Van.Beasts">
    <defName>WitcherMonsters_Flavor_DA_RockTroll</defName>
    <questTitle>Stone giant on the pass</questTitle>
    <questDescription>Caravans from [settlement] will not cross the mountain pass. A creature of living rock blocks the road and hurls boulders.</questDescription>
    <preferredScene>AbandonedCart</preferredScene>
  </ContractFlavorDef>
  <ContractFlavorDef MayRequire="Van.Beasts">
    <defName>WitcherMonsters_Flavor_DA_BeardedTroll</defName>
    <questTitle>Troll under the bridge</questTitle>
    <questDescription>Millers near [settlement] say a bearded giant lives under the old bridge, taking toll in flesh. Travelers have stopped coming.</questDescription>
    <preferredScene>AbandonedCamp</preferredScene>
  </ContractFlavorDef>
  <ContractFlavorDef MayRequire="Van.Beasts">
    <defName>WitcherMonsters_Flavor_DA_Crestel</defName>
    <questTitle>Screeching bird-thing</questTitle>
    <questDescription>Shepherds from [settlement] cover their ears. A crested horror with a piercing cry turns men to stone — or so the survivors claim.</questDescription>
    <preferredScene>CorpseField</preferredScene>
  </ContractFlavorDef>
  <ContractFlavorDef MayRequire="Van.Beasts">
    <defName>WitcherMonsters_Flavor_DA_Snaptoad</defName>
    <questTitle>Swamp bellowing</questTitle>
    <questDescription>Hunters from [settlement] will not enter the marsh. Something huge and toad-like spews filth that melts leather armor.</questDescription>
    <preferredScene>CorpseField</preferredScene>
  </ContractFlavorDef>
  <ContractFlavorDef MayRequire="Van.Beasts">
    <defName>WitcherMonsters_Flavor_DA_Phrak</defName>
    <questTitle>Spined crawlers</questTitle>
    <questDescription>Trappers near [settlement] found camps pierced by toxic spines. Two beasts with barbed tails hunt in pairs — fast and venomous.</questDescription>
    <preferredScene>AbandonedCamp</preferredScene>
  </ContractFlavorDef>
  <ContractFlavorDef MayRequire="Van.Beasts">
    <defName>WitcherMonsters_Flavor_DA_BlackScribe</defName>
    <questTitle>Thing in the scriptorium</questTitle>
    <questDescription>Monks from [settlement] whisper of a black-scaled creature that drinks ink and blood alike. One survivor begs you to burn the abbey cellars.</questDescription>
    <preferredScene>AbandonedCamp</preferredScene>
  </ContractFlavorDef>

  <ContractEncounterDef MayRequire="Van.Beasts">
