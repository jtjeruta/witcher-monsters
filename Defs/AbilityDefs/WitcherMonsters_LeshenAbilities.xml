<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <AbilityDef>
    <defName>WitcherMonsters_LeshenSummonWolves</defName>
    <label>summon wolves</label>
    <description>Call maddened wolves from the surrounding forest to join the hunt.</description>
    <iconPath>UI/Abilities/AnimalWarcall</iconPath>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>false</targetRequired>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>1.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="WitcherMonsters.CompProperties_AbilitySummonWolves">
        <wolfCount>4~6</wolfCount>
        <spawnRadius>4~8</spawnRadius>
        <maxAlliedWolvesNearby>6</maxAlliedWolvesNearby>
        <enemySearchRadius>25</enemySearchRadius>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="EntitySkip">
    <defName>WitcherMonsters_LeshenSkip</defName>
    <label>forest skip</label>
    <description>Teleport through the trees to escape a nearby threat.</description>
    <aiCanUse>false</aiCanUse>
    <cooldownTicksRange>1200~2400</cooldownTicksRange>
  </AbilityDef>

  <AbilityDef ParentName="SpikeLaunchBase">
    <defName>WitcherMonsters_LeshenSpineLaunch</defName>
    <label>vine spine</label>
    <description>Launch a keratin spine at a distant foe.</description>
    <cooldownTicksRange>130</cooldownTicksRange>
    <verbProperties>
      <range>17.9</range>
      <soundCast>Gorehulk_Spine_Launch</soundCast>
      <defaultProjectile>Spine_Gorehulk</defaultProjectile>
    </verbProperties>
  </AbilityDef>

</Defs>
